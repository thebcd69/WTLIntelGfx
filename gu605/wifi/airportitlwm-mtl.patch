+    UInt32 total = (UInt32)r.pos & 0x7FFFFFFFu;
+    UInt32 len = total < MTL_RING_SIZE ? total : MTL_RING_SIZE;
+    if (!len || !req->oldptr)
+        return SYSCTL_OUT(req, r.buf, len);
+    char *tmp = (char *)IOMalloc(len);
