+void ItlIwx::
+iwx_scan_umac_fill_general_p_v11(struct iwx_softc *sc,
+                                 struct iwx_scan_general_params_v11 *gp, uint16_t gen_flags, int bgscan)
+{
+    uint32_t suspend_time, max_out_time;
