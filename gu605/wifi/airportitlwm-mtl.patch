+/* MTL: wait (bounded) until the firmware has completed every queued TX frame, like Linux
+ * iwl_mvm_wait_sta_queues_empty() does after the flush and before queues/station are removed. */
+void ItlIwx::
+iwx_mld_wait_tx_empty(struct iwx_softc *sc, int max_ms)
+{
+    int waited, q, busy = 0;
+    
+    for (waited = 0; waited <= max_ms; waited += 10) {
+        busy = 0;
+        for (q = 0; q < nitems(sc->txq); q++)
+            if (q != IWX_DQA_CMD_QUEUE && sc->txq[q].queued)    /* ring 0 = host commands, not TX */
+                busy++;
+        if (!busy)
+            break;
+        if (getMainWorkLoop()->inGate()) {   /* let the TX-done interrupts in: sleep on the gate, not with it */
+            AbsoluteTime deadline;
+            clock_interval_to_deadline(10, kMillisecondScale, reinterpret_cast<uint64_t *>(&deadline));
+            getMainCommandGate()->commandSleep(&sc->txq, deadline, THREAD_UNINT);
+        } else
+            tsleep_nsec(&sc->txq, 0, "iwxtxe", MSEC_TO_NSEC(10));
+    }
+    XYLog("MTL: TX rings %s after %d ms (%d busy)\n", busy ? "NOT empty" : "empty", waited, busy);
+    for (q = 1; q < 4 && q < nitems(sc->txq); q++)
+        XYLog("MTL:   ring %d qid %d cur %d queued %d\n", q, sc->txq[q].qid, sc->txq[q].cur, sc->txq[q].queued);
+}
