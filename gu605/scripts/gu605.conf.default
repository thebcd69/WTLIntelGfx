# /Library/XeGfx/gu605/gu605.conf: what the boot-time runner (gu605-auto.sh) may do. Levels:
#   off | probe (read-only stages 1-2) | gt (stages to 6: i915, GuC, engines) | metal (to 7 + Metal test in a test
#   process) | desktop (metal + WindowServer on the Intel GPU, at the login window)
# first test: metal (no WindowServer restart); desktop afterwards
ECO_LEVEL=metal
STANDARD_LEVEL=probe
# zero-copy flip after a confirmed desktop (samwu07), WindowServer completion marks, AGDC K5 link answers
FLIP=1
# asynchronous flip (XeGfxAccel debug.nvaccel_xeflip_async): the swap waits for the GPU and the panel's latch on its own
# thread, not on WindowServer's (240 Hz). 0 = synchronous. Off for later boots by itself if WindowServer restarts in
# its first minute (file mark xeflip-async-off; delete that file to try again)
FLIP_ASYNC=0
WSMARK=1
K5=1
# DDC/CI (hardware brightness of the external monitor, BetterDisplay's DDC mode) through the Intel framebuffer:
# 1 = on, 0 = off (applied at every boot by gu605-auto.sh; at once by hand: sudo tools/xeddcprobe enable 0)
DDC=1
# copy each run's summary to <EFI>/GU605/ (readable from Windows); 0 = never mount the EFI
EFI_LOG=1
# display path (docs/GU605-DISPLAY-DESIGN.md, branch gu605-display): adopt = keep the firmware's pipe (gu605-mtl);
#   kms = Linux i915 owns the display (Eco): 240 Hz, the left USB-C port, native brightness. Falls back to adopt by
#   itself (takeover preflight, kms-failed after a failed stage 4, boot-arg -xegfxnokms).
DISPLAY=adopt
# internal panel refresh after the KMS takeover (Hz; empty or 0 = leave the firmware's)
PANEL_HZ=240
# desktop step when someone is already logged in (gu605-desktop.sh): auto = an automatic login left idle restarts
# WindowServer after a 20 s notice, else at the next logout | logout = always at the next logout | skip = never
# Default logout: on the GU605 (2026-11-05 13:11) a WindowServer restart under a live session gave a black screen
# (power button); auto stays opt-in until it ends the session first.
DESKTOP_LOGGED_IN=logout
DESKTOP_AUTOLOGIN_S=150
DESKTOP_IDLE_S=60
DESKTOP_WAIT_MIN=120
# early arming (gu605-desktop.sh "early"): 1 = when the stages reach 7 while the boot's first WindowServer is still
# waiting for the GPU (it waits 60 s, GPUWranglerWaitForPublish), arm the accelerator right then: WindowServer comes up
# on the Intel GPU at its first start and nothing is restarted. An attempt that fails, or is never confirmed, writes
# early-arm-off next to this file and later boots go the usual way (remove that file to try again).
EARLY_ARM=0
# early arming only while WindowServer is younger than this (its wait for the GPU ends about 74 s after its start)
EARLY_ARM_MAX_WS_S=55
# the hold (XeGfxIntelFB boot.inc): 1 = after every confirmed Eco desktop, nvram xeintelfb-hold=1 is written, and the
# next Eco boot's XeGfxIntelFB keeps IOKit busy after its start (70 s at most) until the runner has armed the
# accelerator: the first WindowServer comes up on the Intel GPU. Needs EARLY_ARM=1. First time: sudo nvram xeintelfb-hold=1
HOLD=0
